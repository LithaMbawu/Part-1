erDiagram
    USERS ||--o{ EVENTS : organises
    EVENTS ||--o{ EVENT_CATEGORIES : offers
    CATEGORIES ||--o{ EVENT_CATEGORIES : contains
    EVENTS ||--o{ ENROLMENTS : receives
    USERS ||--o{ ENROLMENTS : makes
    EVENT_CATEGORIES ||--o{ ENROLMENTS : selected_for
    ENROLMENTS ||--o| RESULTS : produces

    USERS {
        int UserId PK
        nvarchar(60) FirstName
        nvarchar(60) LastName
        nvarchar(320) Email UK
        nvarchar(255) PasswordHash
        nvarchar(20) Role
        nvarchar(30) Phone NULL
        datetime2(0) CreatedAt
    }
    EVENTS {
        int EventId PK
        int OrganiserId FK
        nvarchar(120) Name
        nvarchar(1000) Description NULL
        datetime2(0) EventDate
        nvarchar(200) Venue
        int Capacity
        nvarchar(20) Status
        datetime2(0) CreatedAt
    }
    CATEGORIES {
        int CategoryId PK
        nvarchar(80) Name UK
        nvarchar(500) Description NULL
    }
    EVENT_CATEGORIES {
        int EventId PK, FK
        int CategoryId PK, FK
        decimal(10,2) EntryFee
    }
    ENROLMENTS {
        int EnrolmentId PK
        int EventId FK
        int ParticipantId FK
        int CategoryId FK
        datetime2(0) EnrolledAt
        nvarchar(20) Status
        int BibNumber UK NULL
    }
    RESULTS {
        int ResultId PK
        int EnrolmentId FK, UK
        int Position NULL
        int FinishTimeSeconds NULL
        nvarchar(20) Status
        datetime2(0) RecordedAt
    }