<Window x:Class="CybersecurityChatbot.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Shield Assistant" Height="820" Width="1180" MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#0B1020">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0891B2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1"
                CornerRadius="16" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="CYBER SHIELD ASSISTANT" Foreground="#67E8F9" FontSize="24"
                           FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="SECURE  •  INFORMED  •  READY" Foreground="#A78BFA" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,5,0,0" />
                <TextBlock Text="Your digital safety coach for passwords, scams, privacy, and phishing awareness."
                           Foreground="#E5E7EB" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="#111827" BorderBrush="#1F2937">
            <TabItem Header="Chat assistant">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ChatListBox" Background="Transparent" BorderThickness="0" Foreground="#F9FAFB"
                             FontSize="14" Padding="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,9" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="MessageBubble" HorizontalAlignment="Left" MaxWidth="820"
                                        Background="#1E293B" CornerRadius="12" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sender}" Foreground="#67E8F9" FontSize="12"
                                                   FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Content}" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFromUser}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="MessageBubble" Property="Background" Value="#164E63" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UserInputTextBox" Height="48" FontSize="16" VerticalContentAlignment="Center"
                                 Margin="0,0,8,0" KeyDown="UserInputTextBox_KeyDown" />
                        <Button Grid.Column="1" Content="Send" Width="92" Margin="0,0,8,0" Click="SendButton_Click" />
                        <ToggleButton Grid.Column="2" x:Name="VoiceToggleButton" Width="135" IsChecked="True"
                                      Content="🔊 Greeting on" Background="#334155" Foreground="White"
                                      Click="VoiceToggleButton_Click" />
                        <Button Grid.Column="3" Content="Exit" Width="75" Margin="8,0,0,0"
                                Background="#B91C1C" Click="ExitButton_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Task assistant">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Cybersecurity tasks" Foreground="#67E8F9" FontSize="21" FontWeight="Bold" />
                        <TextBlock x:Name="DatabaseStatusText" Text="Connecting to the configured MySQL database…"
                                   Foreground="#CBD5E1" Margin="0,5,0,14" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="#0F172A" CornerRadius="12" Padding="14" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="Add a task" Foreground="#E2E8F0" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Text="Title" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBox x:Name="TaskTitleTextBox" MaxLength="200" />
                                <TextBlock Text="Description" Foreground="#94A3B8" Margin="0,10,0,4" />
                                <TextBox x:Name="TaskDescriptionTextBox" Height="90" MaxLength="2000"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="Optional reminder date" Foreground="#94A3B8" Margin="0,10,0,4" />
                                <DatePicker x:Name="ReminderDatePicker" />
                                <Button x:Name="AddTaskButton" Content="Save task" Margin="0,14,0,0" Click="AddTaskButton_Click" />
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="TaskListDataGrid" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" SelectionMode="Single" Background="#0F172A" Foreground="#E2E8F0"
                                  RowBackground="#172033" AlternatingRowBackground="#1E293B" BorderBrush="#334155"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Task" Binding="{Binding Title}" Width="1.2*" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                                <DataGridTextColumn Header="Reminder" Binding="{Binding ReminderAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.2*" />
                                <DataGridCheckBoxColumn Header="Done" Binding="{Binding IsCompleted}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Mark complete / reopen" Click="ToggleTaskCompletedButton_Click" />
                        <Button Content="Update reminder" Margin="8,0,0,0" Click="UpdateTaskReminderButton_Click" />
                        <Button Content="Clear reminder" Margin="8,0,0,0" Click="ClearTaskReminderButton_Click" />
                        <Button Content="Delete selected" Margin="8,0,0,0" Background="#B91C1C" Click="DeleteTaskButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Cyber quiz">
                <Grid Margin="24" MaxWidth="820" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Cybersecurity mini-game" Foreground="#67E8F9" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="QuizProgressText" Grid.Row="1" Text="12 questions · multiple-choice and true/false"
                               Foreground="#94A3B8" Margin="0,7,0,18" />
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="14" Padding="22">
                        <StackPanel>
                            <TextBlock x:Name="QuizQuestionText" Text="Start the quiz when you're ready."
                                       Foreground="#F8FAFC" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel x:Name="QuizOptionsPanel" Margin="0,16,0,0" />
                            <TextBlock x:Name="QuizFeedbackText" Foreground="#A7F3D0" TextWrapping="Wrap"
                                       Margin="0,14,0,0" FontSize="14" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="QuizScoreText" Grid.Row="3" Foreground="#CBD5E1" Margin="0,12,0,0" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="StartQuizButton" Content="Start / restart quiz" Click="StartQuizButton_Click" />
                        <Button x:Name="SubmitQuizAnswerButton" Content="Submit answer" Margin="8,0,0,0"
                                IsEnabled="False" Click="SubmitQuizAnswerButton_Click" />
                        <Button x:Name="NextQuizQuestionButton" Content="Next question" Margin="8,0,0,0"
                                IsEnabled="False" Click="NextQuizQuestionButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Activity log">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Recent activity" Foreground="#67E8F9" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="Actions are categorized and timestamped. Start with the latest 10, then show more as needed."
                                   Foreground="#94A3B8" Margin="0,5,0,14" />
                    </StackPanel>
                    <ListBox x:Name="ActivityListBox" Grid.Row="1" Background="#0F172A" Foreground="#E2E8F0"
                             BorderBrush="#334155" Padding="10" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock x:Name="ActivityCountText" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="ShowMoreActivityButton" Content="Show 10 more" Click="ShowMoreActivityButton_Click" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
