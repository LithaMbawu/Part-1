<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CybersecurityChatbot.Desktop.MainWindow"
        Title="Cyber Shield Assistant" Width="1120" Height="760"
        MinWidth="780" MinHeight="560" Background="#0B1020">
  <Grid RowDefinitions="Auto,*" Margin="22">
    <Border Grid.Row="0" Background="#111827" BorderBrush="#263449" BorderThickness="1"
            CornerRadius="18" Padding="18" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Text="CYBER SHIELD ASSISTANT" Foreground="#67E8F9" FontSize="23"
                   FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="SECURE  •  INFORMED  •  READY" Foreground="#A78BFA" FontSize="12"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Your digital safety coach for passwords, scams, privacy, and phishing awareness."
                   Foreground="#E5E7EB" FontSize="14" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1">
      <TabItem Header="Chat assistant">
        <Grid RowDefinitions="*,Auto" Margin="14">
          <ScrollViewer Grid.Row="0" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChatItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{Binding BubbleColor}" CornerRadius="12" Padding="13"
                          Margin="0,0,0,10" HorizontalAlignment="{Binding Alignment}" MaxWidth="800">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Sender}" Foreground="#67E8F9" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="{Binding Content}" Foreground="#F8FAFC" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBox x:Name="UserInput" Grid.Column="0" Watermark="Ask about passwords, phishing, privacy…"
                     MinHeight="44" VerticalContentAlignment="Center" KeyDown="UserInput_KeyDown" />
            <Button Grid.Column="1" Content="Send" MinWidth="90" Margin="10,0,0,0"
                    Click="Send_Click" Background="#0891B2" />
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Tasks">
        <Grid ColumnDefinitions="300,*" RowDefinitions="Auto,*" Margin="16">
          <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12" Spacing="4">
            <TextBlock Text="Cybersecurity tasks" FontSize="21" FontWeight="Bold" Foreground="#67E8F9" />
            <TextBlock x:Name="DatabaseStatus" Text="Task storage is not configured." Foreground="#CBD5E1" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Row="1" Grid.Column="0" Background="#0F172A" CornerRadius="12" Padding="14" Margin="0,0,14,0">
            <StackPanel Spacing="9">
              <TextBlock Text="Add a task" FontSize="17" FontWeight="SemiBold" />
              <TextBox x:Name="TaskTitle" Watermark="Task title" MaxLength="200" />
              <TextBox x:Name="TaskDescription" Watermark="Description" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="100" MaxLength="2000" />
              <Button x:Name="AddTaskButton" Content="Save task" Click="AddTask_Click" Background="#0891B2" />
              <TextBlock Text="To add a reminder, ask in chat, e.g. ‘Remind me to update my password tomorrow’."
                         Foreground="#94A3B8" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </Border>
          <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,Auto">
            <ListBox x:Name="TaskItems" Background="#0F172A">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="8" Spacing="3">
                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Description}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReminderText}" Foreground="#67E8F9" FontSize="12" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Spacing="8">
              <Button Content="Complete / reopen" Click="ToggleTask_Click" />
              <Button Content="Delete selected" Click="DeleteTask_Click" Background="#B91C1C" />
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Cyber quiz">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" MaxWidth="800" HorizontalAlignment="Center" Margin="24">
          <TextBlock Text="Cybersecurity mini-game" Foreground="#67E8F9" FontSize="22" FontWeight="Bold" />
          <TextBlock x:Name="QuizProgress" Grid.Row="1" Text="12 questions · multiple-choice and true/false"
                     Foreground="#94A3B8" Margin="0,8,0,18" />
          <Border Grid.Row="2" Background="#0F172A" CornerRadius="14" Padding="22">
            <StackPanel Spacing="14">
              <TextBlock x:Name="QuizQuestion" Text="Start the quiz when you're ready." Foreground="#F8FAFC"
                         FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
              <StackPanel x:Name="QuizOptions" Spacing="10" />
              <TextBlock x:Name="QuizFeedback" Foreground="#A7F3D0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="QuizScore" Grid.Row="3" Foreground="#CBD5E1" Margin="0,12,0,0" />
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0" Spacing="8">
            <Button Content="Start / restart quiz" Click="StartQuiz_Click" Background="#0891B2" />
            <Button x:Name="SubmitAnswerButton" Content="Submit answer" IsEnabled="False" Click="SubmitAnswer_Click" />
            <Button x:Name="NextQuestionButton" Content="Next question" IsEnabled="False" Click="NextQuestion_Click" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Activity log">
        <Grid RowDefinitions="Auto,*" Margin="18">
          <StackPanel Margin="0,0,0,12" Spacing="4">
            <TextBlock Text="Recent activity" Foreground="#67E8F9" FontSize="21" FontWeight="Bold" />
            <TextBlock Text="The latest 10 chatbot actions are shown here and in response to ‘show activity log’."
                       Foreground="#94A3B8" />
          </StackPanel>
          <ListBox x:Name="ActivityItems" Grid.Row="1" Background="#0F172A" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
